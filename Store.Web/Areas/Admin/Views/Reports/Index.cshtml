@model PharmacyWeb.Models.ViewModels.RevenueReportViewModel
@{
    ViewData["Title"] = "Báo Cáo Doanh Thu Thực Thu";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold text-dark mb-1">Báo Cáo Doanh Thu Đã Thu</h4>
        <span class="text-muted small">Ghi nhận dòng tiền các đơn hàng đã thanh toán thành công (không tính đơn hủy hay chờ xử lý)</span>
    </div>
    <a asp-action="ExportCsv" asp-route-fromDate="@Model.FromDate.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate.ToString("yyyy-MM-dd")" class="btn btn-outline-success rounded-pill btn-sm px-3 shadow-sm">
        <i class="bi bi-file-earmark-spreadsheet me-1"></i> Xuất dữ liệu CSV
    </a>
</div>

<!-- Date Filter Card -->
<div class="card border-0 rounded-4 shadow-sm p-3 bg-white mb-4">
    <form asp-action="Index" method="get" class="row g-2 align-items-center">
        <div class="col-md-4">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-light text-muted">Từ ngày</span>
                <input type="date" name="fromDate" class="form-control" value="@Model.FromDate.ToString("yyyy-MM-dd")" />
            </div>
        </div>
        <div class="col-md-4">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-light text-muted">Đến ngày</span>
                <input type="date" name="toDate" class="form-control" value="@Model.ToDate.ToString("yyyy-MM-dd")" />
            </div>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary rounded-pill btn-sm w-100" style="background-color: var(--color-primary); border-color: var(--color-primary);">
                <i class="bi bi-funnel me-1"></i> Xem báo cáo
            </button>
        </div>
    </form>
</div>

<!-- Summary Metric Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 rounded-4 shadow-sm p-4 bg-white h-100">
            <span class="text-muted small fw-semibold">Tổng thực thu trong kỳ:</span>
            <h3 class="fw-bold text-success my-2" style="font-variant-numeric: tabular-nums;">
                @Model.TotalCollectedRevenue.ToString("N0") ₫
            </h3>
            <span class="small text-muted">@Model.TotalPaidOrders giao dịch đã thu tiền</span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 rounded-4 shadow-sm p-4 bg-white h-100">
            <span class="text-muted small fw-semibold">Tổng tiền hoàn lại:</span>
            <h3 class="fw-bold text-danger my-2" style="font-variant-numeric: tabular-nums;">
                @Model.TotalRefundedAmount.ToString("N0") ₫
            </h3>
            <span class="small text-muted">@Model.TotalRefundedOrders đơn đã xử lý hoàn tiền</span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 rounded-4 shadow-sm p-4 bg-white h-100">
            <span class="text-muted small fw-semibold">Doanh thu thực còn lại (Net):</span>
            <h3 class="fw-bold text-teal my-2" style="color: var(--color-primary); font-variant-numeric: tabular-nums;">
                @Model.NetRevenue.ToString("N0") ₫
            </h3>
            <span class="small text-muted">Thực thu trừ tiền đã hoàn</span>
        </div>
    </div>
</div>

<!-- Report Table -->
<div class="card border-0 rounded-4 shadow-sm bg-white overflow-hidden">
    <div class="table-responsive">
        <table class="table align-middle mb-0 small">
            <thead class="table-light text-secondary">
                <tr>
                    <th class="ps-4">Mã đơn</th>
                    <th>Thời gian đặt</th>
                    <th>Thời gian thu</th>
                    <th>Khách hàng</th>
                    <th>Phương thức</th>
                    <th>Trạng thái TT</th>
                    <th class="text-end">Tiền thu</th>
                    <th class="text-end">Tiền hoàn</th>
                    <th class="text-end">Thực nhận</th>
                    <th class="pe-4 text-end">Người xử lý</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model.Orders)
                {
                    <tr>
                        <td class="ps-4 py-3 font-monospace fw-bold text-teal" style="color: var(--color-primary);">@o.OrderCode</td>
                        <td>@o.OrderDate.AddHours(7).ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-success fw-semibold">
                            @(o.PaidAt.HasValue ? o.PaidAt.Value.AddHours(7).ToString("dd/MM/yyyy HH:mm") : "-")
                        </td>
                        <td class="fw-semibold">@o.CustomerName</td>
                        <td><span class="badge bg-light text-dark border">@o.PaymentMethod</span></td>
                        <td>
                            @if (o.IsRefunded)
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger">Đã hoàn tiền</span>
                            }
                            else
                            {
                                <span class="badge bg-success-subtle text-success border border-success">Đã thanh toán</span>
                            }
                        </td>
                        <td class="text-end fw-semibold text-success" style="font-variant-numeric: tabular-nums;">
                            @(o.CollectedInPeriod > 0 ? o.CollectedInPeriod.ToString("N0") + " ₫" : "-")
                        </td>
                        <td class="text-end fw-semibold text-danger" style="font-variant-numeric: tabular-nums;">
                            @(o.RefundedInPeriod > 0 ? "-" + o.RefundedInPeriod.ToString("N0") + " ₫" : "-")
                        </td>
                        <td class="text-end fw-bold text-teal" style="font-variant-numeric: tabular-nums;">
                            @o.NetAmount.ToString("N0") ₫
                        </td>
                        <td class="pe-4 text-end text-muted">
                            @(o.IsRefunded ? (o.RefundedBy ?? o.PaidBy) : o.PaidBy)
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
