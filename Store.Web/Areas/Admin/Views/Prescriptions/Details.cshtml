@model PharmacyWeb.Models.ViewModels.PrescriptionRequestItemViewModel
@{
    ViewData["Title"] = $"Yêu Cầu Tư Vấn {Model.Code}";
}

<div class="container-fluid p-0" style="max-width: 900px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-dark mb-1">Đơn Thuốc: <span class="font-monospace text-teal">@Model.Code</span></h4>
            <span class="text-muted small">Bệnh nhân: <strong>@Model.PatientName</strong> (@Model.Phone)</span>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill btn-sm px-3">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
        </a>
    </div>

    <!-- Request Details & Images -->
    <div class="card border-0 rounded-4 shadow-sm p-4 bg-white mb-4">
        <h6 class="fw-bold text-dark mb-3"><i class="bi bi-image me-2 text-teal"></i>Ảnh đơn thuốc chụp bởi bệnh nhân</h6>
        
        <div class="row g-3 mb-4">
            @foreach (var img in Model.Images)
            {
                <div class="col-sm-6 col-md-4">
                    <div class="card border rounded-3 p-2 bg-light text-center h-100">
                        <a href="@img.ViewUrl" target="_blank" class="d-block mb-2" style="height: 180px;">
                            <img src="@img.ViewUrl" alt="@img.FileName" class="img-fluid h-100 object-fit-contain rounded" />
                        </a>
                        <div class="text-truncate small fw-semibold text-secondary">@img.FileName</div>
                        <a href="@img.ViewUrl" target="_blank" class="btn btn-outline-primary btn-sm rounded-pill mt-2 py-0" style="font-size: 0.75rem;">
                            <i class="bi bi-arrows-fullscreen me-1"></i>Phóng to ảnh
                        </a>
                    </div>
                </div>
            }
        </div>

        @if (!string.IsNullOrEmpty(Model.CustomerNote))
        {
            <div class="p-3 rounded-3 bg-light border small text-secondary mb-3">
                <strong>Ghi chú / Câu hỏi của bệnh nhân:</strong> @Model.CustomerNote
            </div>
        }
    </div>

    <!-- Pharmacist Response Form -->
    <div class="card border-0 rounded-4 shadow-sm p-4 bg-white">
        <h6 class="fw-bold text-teal mb-3" style="color: var(--color-primary);"><i class="bi bi-chat-quote-fill me-2"></i>Phản Hồi Hướng Dẫn Của Dược Sĩ</h6>
        
        <form asp-action="Respond" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />

            <div class="mb-3">
                <label class="form-label small fw-semibold text-secondary">Cập nhật trạng thái xử lý:</label>
                <select name="newStatus" class="form-select rounded-3">
                    <option value="RESPONDED" selected="@(Model.Status == "RESPONDED")">Đã kiểm tra &amp; Phản hồi</option>
                    <option value="NEED_MORE_INFO" selected="@(Model.Status == "NEED_MORE_INFO")">Yêu cầu chụp lại rõ nét / Bổ sung đơn</option>
                    <option value="PENDING_REVIEW" selected="@(Model.Status == "PENDING_REVIEW")">Chờ kiểm tra</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label small fw-semibold text-secondary">Lời dặn / Hướng dẫn của Dược sĩ:</label>
                <textarea name="pharmacistNote" rows="4" class="form-control rounded-3" placeholder="vd: Đơn thuốc hợp lệ, liều lượng chuẩn. Sản phẩm hiện có sẵn tại nhà thuốc..." required>@Model.PharmacistNote</textarea>
            </div>

            <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold" style="background-color: var(--color-primary); border-color: var(--color-primary);">
                <i class="bi bi-send-check-fill me-1"></i> Lưu và gửi phản hồi cho bệnh nhân
            </button>
        </form>
    </div>
</div>
