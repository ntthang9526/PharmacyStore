@model PharmacyWeb.Models.ViewModels.StockInFormViewModel
@{
    ViewData["Title"] = "Lập Phiếu Nhập Kho Mới";
    var medicines = (ViewBag.Medicines as PharmacyWeb.Models.ViewModels.PagedResult<PharmacyWeb.Models.ViewModels.ProductCardViewModel>)?.Items ?? new();
    var existingLines = Model?.Lines ?? new();
}

<div class="container-fluid p-0" style="max-width: 960px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-dark mb-1">Lập Phiếu Nhập Kho Nhiều Dòng</h4>
            <span class="text-muted small">Cập nhật số lô, hạn sử dụng và giá vốn nhập hàng vào kho</span>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill btn-sm px-3">
            <i class="bi bi-arrow-left me-1"></i> Quay lại kho
        </a>
    </div>

    <!-- Hidden Template Select for Medicines with Supplier Attributes -->
    <select id="medicineSelectTemplate" class="d-none">
        <option value="">-- Chọn thuốc --</option>
        @foreach (var m in medicines)
        {
            <option value="@m.Id" data-supplier="@m.SupplierId">@m.Name (@m.Unit)</option>
        }
    </select>

    <div class="card border-0 rounded-4 shadow-sm p-4 bg-white">
        <form asp-action="StockIn" method="post" id="stockInForm">
            @Html.AntiForgeryToken()

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="SupplierId" class="form-label small fw-semibold text-secondary">Nhà cung cấp (*)</label>
                    <select asp-for="SupplierId" asp-items="ViewBag.Suppliers" class="form-select rounded-3" id="supplierSelect" required onchange="filterMedicinesBySupplier()">
                        <option value="">-- Chọn nhà cung cấp nhập hàng --</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="Note" class="form-label small fw-semibold text-secondary">Ghi chú phiếu nhập</label>
                    <input asp-for="Note" class="form-control rounded-3" placeholder="vd: Nhập định kỳ tháng 11/2026..." />
                </div>
            </div>

            <!-- Multi-line items table -->
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="fw-bold text-dark mb-0"><i class="bi bi-list-check me-1 text-teal"></i>Danh sách thuốc nhập</h6>
                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill" onclick="addRow()">
                    <i class="bi bi-plus-circle me-1"></i>Thêm dòng thuốc
                </button>
            </div>

            <div class="table-responsive border rounded-3 mb-3">
                <table class="table table-sm align-middle mb-0 small" id="linesTable">
                    <thead class="table-light">
                        <tr>
                            <th style="min-width: 220px;">Thuốc</th>
                            <th style="min-width: 130px;">Số lô</th>
                            <th style="min-width: 140px;">Hạn dùng</th>
                            <th style="min-width: 90px;">Số lượng</th>
                            <th style="min-width: 110px;">Giá nhập (₫)</th>
                            <th style="min-width: 110px;" class="text-end">Thành tiền</th>
                            <th style="width: 40px;"></th>
                        </tr>
                    </thead>
                    <tbody id="linesContainer">
                        @if (existingLines.Any())
                        {
                            for (int i = 0; i < existingLines.Count; i++)
                            {
                                var line = existingLines[i];
                                <tr class="line-row">
                                    <input type="hidden" name="Lines.Index" value="@i" />
                                    <td>
                                        <select name="Lines[@i].MedicineId" class="form-select form-select-sm med-select" required>
                                            <option value="">-- Chọn thuốc --</option>
                                            @foreach (var m in medicines)
                                            {
                                                <option value="@m.Id" data-supplier="@m.SupplierId" selected="@(m.Id == line.MedicineId)">@m.Name (@m.Unit)</option>
                                            }
                                        </select>
                                    </td>
                                    <td><input type="text" name="Lines[@i].BatchNumber" value="@line.BatchNumber" class="form-control form-control-sm font-monospace" placeholder="LOT-..." required /></td>
                                    <td><input type="date" name="Lines[@i].ExpiryDate" value="@(line.ExpiryDate != default ? line.ExpiryDate.ToString("yyyy-MM-dd") : "")" class="form-control form-control-sm" required /></td>
                                    <td><input type="number" name="Lines[@i].Quantity" value="@line.Quantity" class="form-control form-control-sm qty-input" min="1" required oninput="calcTotals()" /></td>
                                    <td><input type="number" name="Lines[@i].UnitCost" value="@((long)line.UnitCost)" class="form-control form-control-sm cost-input" min="0" step="1000" required oninput="calcTotals()" /></td>
                                    <td class="text-end fw-bold line-total">@((line.Quantity * line.UnitCost).ToString("N0")) ₫</td>
                                    <td class="text-center"><button type="button" class="btn btn-link text-danger p-0" onclick="removeRow(this)"><i class="bi bi-x-circle"></i></button></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr class="line-row">
                                <input type="hidden" name="Lines.Index" value="0" />
                                <td>
                                    <select name="Lines[0].MedicineId" class="form-select form-select-sm med-select" required>
                                        <option value="">-- Chọn thuốc --</option>
                                        @foreach (var m in medicines)
                                        {
                                            <option value="@m.Id" data-supplier="@m.SupplierId">@m.Name (@m.Unit)</option>
                                        }
                                    </select>
                                </td>
                                <td><input type="text" name="Lines[0].BatchNumber" class="form-control form-control-sm font-monospace" placeholder="LOT-..." required /></td>
                                <td><input type="date" name="Lines[0].ExpiryDate" class="form-control form-control-sm" required /></td>
                                <td><input type="number" name="Lines[0].Quantity" class="form-control form-control-sm qty-input" value="10" min="1" required oninput="calcTotals()" /></td>
                                <td><input type="number" name="Lines[0].UnitCost" class="form-control form-control-sm cost-input" value="25000" min="0" step="1000" required oninput="calcTotals()" /></td>
                                <td class="text-end fw-bold line-total">250,000 ₫</td>
                                <td class="text-center"><button type="button" class="btn btn-link text-danger p-0" onclick="removeRow(this)"><i class="bi bi-x-circle"></i></button></td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="5" class="fw-bold ps-3">Tổng giá trị phiếu nhập:</td>
                            <td class="text-end fw-bold text-teal fs-6" id="grandTotal">250,000 ₫</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm" style="background-color: var(--color-primary); border-color: var(--color-primary);">
                <i class="bi bi-check-circle-fill me-1"></i> Lưu & Ghi sổ kho
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        let nextRowId = document.querySelectorAll('.line-row').length || 1;

        function addRow() {
            const tbody = document.getElementById('linesContainer');
            const tr = document.createElement('tr');
            tr.className = 'line-row';
            const rowIdx = nextRowId++;
            const templateHtml = document.getElementById('medicineSelectTemplate').innerHTML;

            tr.innerHTML = `
                <input type="hidden" name="Lines.Index" value="${rowIdx}" />
                <td>
                    <select name="Lines[${rowIdx}].MedicineId" class="form-select form-select-sm med-select" required>
                        ${templateHtml}
                    </select>
                </td>
                <td><input type="text" name="Lines[${rowIdx}].BatchNumber" class="form-control form-control-sm font-monospace" placeholder="LOT-..." required /></td>
                <td><input type="date" name="Lines[${rowIdx}].ExpiryDate" class="form-control form-control-sm" required /></td>
                <td><input type="number" name="Lines[${rowIdx}].Quantity" class="form-control form-control-sm qty-input" value="10" min="1" required oninput="calcTotals()" /></td>
                <td><input type="number" name="Lines[${rowIdx}].UnitCost" class="form-control form-control-sm cost-input" value="25000" min="0" step="1000" required oninput="calcTotals()" /></td>
                <td class="text-end fw-bold line-total">250,000 ₫</td>
                <td class="text-center"><button type="button" class="btn btn-link text-danger p-0" onclick="removeRow(this)"><i class="bi bi-x-circle"></i></button></td>
            `;
            tbody.appendChild(tr);
            filterMedicinesBySupplier();
            reindexRows();
            calcTotals();
        }

        function removeRow(btn) {
            const rows = document.querySelectorAll('.line-row');
            if (rows.length > 1) {
                btn.closest('tr').remove();
                reindexRows();
                calcTotals();
            } else {
                alert('Phiếu nhập phải có ít nhất 1 dòng thuốc.');
            }
        }

        function reindexRows() {
            const rows = document.querySelectorAll('.line-row');
            rows.forEach((row, idx) => {
                const indexInput = row.querySelector('input[name="Lines.Index"]');
                if (indexInput) indexInput.value = idx;
                const select = row.querySelector('select[name^="Lines["]');
                if (select) select.name = `Lines[${idx}].MedicineId`;
                const batch = row.querySelector('input[name$=".BatchNumber"]');
                if (batch) batch.name = `Lines[${idx}].BatchNumber`;
                const expiry = row.querySelector('input[name$=".ExpiryDate"]');
                if (expiry) expiry.name = `Lines[${idx}].ExpiryDate`;
                const qty = row.querySelector('input[name$=".Quantity"]');
                if (qty) qty.name = `Lines[${idx}].Quantity`;
                const cost = row.querySelector('input[name$=".UnitCost"]');
                if (cost) cost.name = `Lines[${idx}].UnitCost`;
            });
        }

        function calcTotals() {
            let total = 0;
            document.querySelectorAll('.line-row').forEach(row => {
                const qty = parseFloat(row.querySelector('.qty-input').value) || 0;
                const cost = parseFloat(row.querySelector('.cost-input').value) || 0;
                const lineTotal = qty * cost;
                row.querySelector('.line-total').innerText = lineTotal.toLocaleString('vi-VN') + ' ₫';
                total += lineTotal;
            });
            document.getElementById('grandTotal').innerText = total.toLocaleString('vi-VN') + ' ₫';
        }

        function filterMedicinesBySupplier() {
            const supplierId = document.getElementById('supplierSelect').value;
            document.querySelectorAll('.med-select').forEach(select => {
                const currentVal = select.value;
                let currentValStillValid = false;
                Array.from(select.options).forEach(opt => {
                    if (!opt.value) {
                        opt.hidden = false;
                        opt.disabled = false;
                        return;
                    }
                    const optSupplier = opt.getAttribute('data-supplier');
                    const matches = !supplierId || optSupplier === supplierId;
                    opt.hidden = !matches;
                    opt.disabled = !matches;
                    if (opt.value === currentVal && matches) {
                        currentValStillValid = true;
                    }
                });
                if (currentVal && !currentValStillValid) {
                    select.value = "";
                }
            });
        }

        document.getElementById('stockInForm').addEventListener('submit', function() {
            reindexRows();
        });

        // Initialize on page load
        filterMedicinesBySupplier();
        calcTotals();
    </script>
}
