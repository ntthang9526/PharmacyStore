@model PharmacyWeb.Models.ViewModels.ProductFilterViewModel
@{
    ViewData["Title"] = "Quản Lý Thuốc & Sản Phẩm";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold text-dark mb-1">Quản Lý Danh Mục Thuốc</h4>
        <span class="text-muted small">Cập nhật thông tin, giá bán, trạng thái kinh doanh và lô hàng</span>
    </div>
    <a asp-action="Create" class="btn btn-primary rounded-pill btn-sm px-4 shadow-sm" style="background-color: var(--color-primary); border-color: var(--color-primary);">
        <i class="bi bi-plus-circle me-1"></i> Thêm thuốc mới
    </a>
</div>

<!-- Search & Filter Card -->
<div class="card border-0 rounded-4 shadow-sm p-3 bg-white mb-3">
    <form asp-action="Index" method="get" class="row g-2 align-items-center">
        <div class="col-md-3">
            <input type="text" name="Keyword" class="form-control form-control-sm rounded-pill" placeholder="Tìm tên thuốc, hoạt chất, mã vạch..." value="@Model.Keyword" />
        </div>
        <div class="col-md-3">
            <select name="CategoryId" class="form-select form-select-sm rounded-pill">
                <option value="">-- Tất cả nhóm thuốc --</option>
                @foreach (var c in Model.Categories)
                {
                    <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <select name="DirectPurchaseOnly" class="form-select form-select-sm rounded-pill">
                <option value="">-- Phân loại --</option>
                <option value="true" selected="@(Model.DirectPurchaseOnly == true)">Mua trực tiếp (OTC)</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="IsActive" class="form-select form-select-sm rounded-pill">
                <option value="">-- Hiển thị: Tất cả --</option>
                <option value="true" selected="@(Model.IsActive == true)">Đang hiển thị</option>
                <option value="false" selected="@(Model.IsActive == false)">Đã ẩn</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary rounded-pill btn-sm w-100" style="background-color: var(--color-primary); border-color: var(--color-primary);">
                <i class="bi bi-search me-1"></i> Lọc
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill btn-sm">Xóa</a>
        </div>
    </form>
</div>

<!-- Products Table -->
<div class="card border-0 rounded-4 shadow-sm bg-white overflow-hidden">
    <div class="table-responsive">
        <table class="table align-middle mb-0 small">
            <thead class="table-light text-secondary">
                <tr>
                    <th class="ps-4">Tên thuốc & Hoạt chất</th>
                    <th>Nhóm thuốc</th>
                    <th>Đơn vị</th>
                    <th>Giá niêm yết</th>
                    <th>Tồn kho (Bán được)</th>
                    <th>Phân loại</th>
                    <th>Bán hàng</th>
                    <th>Hoạt động (Web &amp; POS)</th>
                    <th class="pe-4 text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Results.Items.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-3 d-block mb-1"></i>
                            Không tìm thấy sản phẩm nào phù hợp với bộ lọc.
                        </td>
                    </tr>
                }
                @foreach (var m in Model.Results.Items)
                {
                    <tr>
                        <td class="ps-4 py-3">
                            <div class="fw-bold text-dark">@m.Name</div>
                            <div class="text-muted" style="font-size: 0.75rem;">@m.ActiveIngredient</div>
                        </td>
                        <td>@m.CategoryName</td>
                        <td><span class="badge bg-light text-secondary border">@m.Unit</span></td>
                        <td class="fw-bold text-teal" style="font-variant-numeric: tabular-nums;">@m.Price.ToString("N0") ₫</td>
                        <td>
                            @if (m.AvailableStock <= 0)
                            {
                                <span class="badge bg-danger">Hết hàng (0)</span>
                            }
                            else if (m.AvailableStock <= 5)
                            {
                                <span class="badge bg-warning text-dark">Thấp (@m.AvailableStock)</span>
                            }
                            else
                            {
                                <span class="badge bg-success-subtle text-success">@m.AvailableStock @m.Unit</span>
                            }
                        </td>
                        <td>
                            @if (m.IsPrescription)
                            {
                                <span class="badge bg-warning-subtle text-warning-emphasis">Cần đơn bác sĩ</span>
                            }
                            else
                            {
                                <span class="badge bg-info-subtle text-info-emphasis">Mua trực tiếp</span>
                            }
                        </td>
                        <td>
                            <form asp-action="ToggleSelling" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@m.Id" />
                                <button type="submit" class="btn btn-sm btn-link p-0 text-decoration-none">
                                    @if (m.IsSelling)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Đang bán</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary"><i class="bi bi-dash-circle me-1"></i>Ngừng bán</span>
                                    }
                                </button>
                            </form>
                        </td>
                        <td>
                            <form asp-action="ToggleActive" method="post" class="m-0" onsubmit="return confirm('Bạn có chắc muốn đổi trạng thái kích hoạt của thuốc này? Lưu ý thao tác này sẽ ảnh hưởng cả Website và phần mềm bán tại quầy POS.');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@m.Id" />
                                <button type="submit" class="btn btn-sm btn-link p-0 text-decoration-none">
                                    @if (m.IsActive)
                                    {
                                        <span class="badge bg-primary" title="Đang kích hoạt dùng chung trên cả Web và quầy thuốc POS"><i class="bi bi-check-circle me-1"></i>Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger" title="Đang tạm dừng trên cả Web và quầy thuốc POS"><i class="bi bi-slash-circle me-1"></i>Tạm dừng</span>
                                    }
                                </button>
                            </form>
                        </td>
                        <td class="pe-4 text-end">
                            <a asp-action="Edit" asp-route-id="@m.Id" class="btn btn-outline-primary btn-sm rounded-pill py-0 px-3">
                                <i class="bi bi-pencil-square me-1"></i>Sửa
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@{
    var queryParams = new Dictionary<string, string>();
    if (!string.IsNullOrEmpty(Model.Keyword)) queryParams["Keyword"] = Model.Keyword;
    if (Model.CategoryId.HasValue) queryParams["CategoryId"] = Model.CategoryId.Value.ToString();
    if (Model.DirectPurchaseOnly.HasValue) queryParams["DirectPurchaseOnly"] = Model.DirectPurchaseOnly.Value.ToString();
    if (Model.IsActive.HasValue) queryParams["IsActive"] = Model.IsActive.Value.ToString();

    var paginationModel = new PharmacyWeb.Models.ViewModels.PaginationViewModel
    {
        CurrentPage = Model.Results.Page,
        PageSize = Model.Results.PageSize,
        TotalItems = Model.Results.TotalItems,
        RouteUrl = Url.Action("Index", "Products", new { area = "Admin" }) ?? "/Admin/Products",
        QueryParams = queryParams
    };
}
<partial name="_Pagination" model="paginationModel" />
