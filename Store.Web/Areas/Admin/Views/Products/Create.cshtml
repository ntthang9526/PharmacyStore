@model PharmacyWeb.Models.ViewModels.AdminProductFormViewModel
@{
    ViewData["Title"] = "Thêm Thuốc Mới";
}

<div class="container-fluid p-0" style="max-width: 900px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-dark mb-1">Thêm Thuốc / Sản Phẩm Mới</h4>
            <span class="text-muted small">Khai báo thông tin chi tiết, đơn vị niêm yết và quy cách đóng gói</span>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill btn-sm px-3">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
        </a>
    </div>

    <div class="card border-0 rounded-4 shadow-sm p-4 bg-white">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="row g-3 mb-3">
                <div class="col-md-8">
                    <label asp-for="Name" class="form-label small fw-semibold text-secondary"></label>
                    <input asp-for="Name" class="form-control rounded-3" placeholder="vd: Panadol Extra 500mg..." />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="BarCode" class="form-label small fw-semibold text-secondary"></label>
                    <input asp-for="BarCode" class="form-control rounded-3 font-monospace" placeholder="8935001800112" />
                    <span asp-validation-for="BarCode" class="text-danger small"></span>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="CategoryId" class="form-label small fw-semibold text-secondary"></label>
                    <select asp-for="CategoryId" asp-items="ViewBag.CategoryOptions" class="form-select rounded-3">
                        <option value="">-- Chọn nhóm thuốc --</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="SupplierId" class="form-label small fw-semibold text-secondary"></label>
                    <select asp-for="SupplierId" asp-items="ViewBag.SupplierOptions" class="form-select rounded-3">
                        <option value="">-- Chọn nhà cung cấp --</option>
                    </select>
                    <span asp-validation-for="SupplierId" class="text-danger small"></span>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="ActiveIngredient" class="form-label small fw-semibold text-secondary"></label>
                    <input asp-for="ActiveIngredient" class="form-control rounded-3" placeholder="vd: Paracetamol 500mg, Caffeine 65mg" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Unit" class="form-label small fw-semibold text-secondary"></label>
                    <input asp-for="Unit" class="form-control rounded-3" placeholder="Hộp, Chai, Tuýp..." />
                    <span asp-validation-for="Unit" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Price" class="form-label small fw-semibold text-secondary"></label>
                    <input asp-for="Price" type="number" step="100" class="form-control rounded-3 fw-bold" placeholder="45000" />
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="PackagingSpec" class="form-label small fw-semibold text-secondary"></label>
                <input asp-for="PackagingSpec" class="form-control rounded-3" placeholder="vd: Hộp 15 vỉ × 12 viên nén bao phim" />
            </div>

            <!-- Image Uploads -->
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="MainImageUpload" class="form-label small fw-semibold text-secondary"></label>
                    <input asp-for="MainImageUpload" type="file" class="form-control rounded-3" accept=".jpg,.jpeg,.png,.webp" />
                    <span class="text-muted" style="font-size: 0.75rem;">Ảnh chính (JPEG/PNG/WebP &le; 5MB).</span>
                </div>
                <div class="col-md-6">
                    <label asp-for="AdditionalImages" class="form-label small fw-semibold text-secondary"></label>
                    <input asp-for="AdditionalImages" type="file" multiple class="form-control rounded-3" accept=".jpg,.jpeg,.png,.webp" />
                    <span class="text-muted" style="font-size: 0.75rem;">Ảnh phụ bổ sung (chọn nhiều ảnh).</span>
                </div>
            </div>

            <!-- Rich Text Editor for Description (Gắn liền với Textarea chuẩn theo yêu cầu đề bài) -->
            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label asp-for="DescriptionHtml" class="form-label small fw-semibold text-secondary mb-0">
                        <i class="bi bi-file-earmark-richtext me-1"></i>Mô tả chi tiết sản phẩm
                    </label>
                    <div class="btn-group btn-group-sm" role="group">
                        <button type="button" class="btn btn-sm btn-primary active py-0 px-2" id="btnModeVisual" onclick="switchEditorMode('visual')" title="Soạn thảo trực quan">
                            <i class="bi bi-eye me-1"></i>Trực quan
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" id="btnModeHtml" onclick="switchEditorMode('html')" title="Xem và sửa trong textarea">
                            <i class="bi bi-code-slash me-1"></i>Textarea HTML
                        </button>
                    </div>
                </div>

                <!-- Thanh công cụ soạn thảo định dạng (Toolbar) -->
                <div class="btn-toolbar p-1 bg-light border border-bottom-0 rounded-top-3 d-flex flex-wrap gap-1 align-items-center" role="toolbar" id="editorToolbar">
                    <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" onclick="applyFormat('bold')" title="In đậm"><strong>B</strong></button>
                    <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" onclick="applyFormat('italic')" title="In nghiêng"><em>I</em></button>
                    <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" onclick="applyFormat('insertUnorderedList')" title="Danh sách chấm"><i class="bi bi-list-ul"></i></button>
                    <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" onclick="applyFormat('insertOrderedList')" title="Danh sách số"><i class="bi bi-list-ol"></i></button>
                    <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" onclick="applyFormat('h3')" title="Tiêu đề mục">H3</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" onclick="applyFormat('removeFormat')" title="Xóa định dạng"><i class="bi bi-eraser"></i></button>
                </div>

                <!-- Khung soạn thảo trực quan (WYSIWYG visual editor) -->
                <div id="visualEditor" contenteditable="true" class="form-control rounded-bottom-3 border-top-0 p-3 bg-white" style="min-height: 140px; outline: none;">
                    @Html.Raw(Model.DescriptionHtml)
                </div>

                <!-- Textarea chính thức của form gắn asp-for="DescriptionHtml" theo đúng yêu cầu đề bài -->
                <textarea asp-for="DescriptionHtml" id="descriptionTextarea" class="form-control font-monospace p-3 small" rows="6" style="display: none; border-top-left-radius: 0; border-top-right-radius: 0;" placeholder="Nhập mã HTML hoặc nội dung mô tả..."></textarea>
                <span asp-validation-for="DescriptionHtml" class="text-danger small"></span>
            </div>

            <!-- Toggles -->
            <div class="row g-3 p-3 bg-light rounded-3 mb-4">
                <div class="col-md-6 col-lg-3">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" asp-for="IsPrescription" id="chkRx" />
                        <label class="form-check-label fw-semibold text-dark small" for="chkRx">Thuốc cần đơn bác sĩ</label>
                        <div class="form-text text-muted" style="font-size: 0.75rem;">Yêu cầu toa thuốc hợp lệ khi mua.</div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" asp-for="IsSelling" id="chkSell" checked />
                        <label class="form-check-label fw-semibold text-dark small" for="chkSell">Cho phép bán hàng (Web &amp; POS)</label>
                        <div class="form-text text-muted" style="font-size: 0.75rem;">Mở bán trên Web và quầy thuốc POS.</div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" asp-for="IsActive" id="chkActive" checked />
                        <label class="form-check-label fw-semibold text-dark small" for="chkActive">Kích hoạt hoạt động (Web &amp; POS)</label>
                        <div class="form-text text-muted" style="font-size: 0.75rem;">Dùng chung hệ thống: tắt cờ này sẽ ẩn trên Web và ngừng bán tại quầy POS.</div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" asp-for="Featured" id="chkFeatured" />
                        <label class="form-check-label fw-semibold text-dark small" for="chkFeatured">Sản phẩm nổi bật</label>
                        <div class="form-text text-muted" style="font-size: 0.75rem;">Ưu tiên hiển thị trang chủ website.</div>
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm" style="background-color: var(--color-primary); border-color: var(--color-primary);">
                <i class="bi bi-save me-1"></i> Lưu thuốc mới
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function syncFromVisualToTextarea() {
            const visual = document.getElementById('visualEditor');
            const textarea = document.getElementById('descriptionTextarea');
            if (visual && textarea) {
                textarea.value = visual.innerHTML;
            }
        }

        function syncFromTextareaToVisual() {
            const visual = document.getElementById('visualEditor');
            const textarea = document.getElementById('descriptionTextarea');
            if (visual && textarea) {
                visual.innerHTML = textarea.value;
            }
        }

        function switchEditorMode(mode) {
            const visual = document.getElementById('visualEditor');
            const textarea = document.getElementById('descriptionTextarea');
            const btnVisual = document.getElementById('btnModeVisual');
            const btnHtml = document.getElementById('btnModeHtml');

            if (mode === 'html') {
                syncFromVisualToTextarea();
                visual.style.display = 'none';
                textarea.style.display = 'block';
                btnHtml.classList.add('active', 'btn-primary');
                btnHtml.classList.remove('btn-outline-secondary');
                btnVisual.classList.remove('active', 'btn-primary');
                btnVisual.classList.add('btn-outline-secondary');
                textarea.focus();
            } else {
                syncFromTextareaToVisual();
                textarea.style.display = 'none';
                visual.style.display = 'block';
                btnVisual.classList.add('active', 'btn-primary');
                btnVisual.classList.remove('btn-outline-secondary');
                btnHtml.classList.remove('active', 'btn-primary');
                btnHtml.classList.add('btn-outline-secondary');
                visual.focus();
            }
        }

        function applyFormat(command, value = null) {
            const visual = document.getElementById('visualEditor');
            const textarea = document.getElementById('descriptionTextarea');
            const isTextareaMode = textarea && textarea.style.display !== 'none';

            if (isTextareaMode) {
                insertTagIntoTextarea(textarea, command);
                syncFromTextareaToVisual();
            } else {
                visual.focus();
                if (command === 'h3') {
                    document.execCommand('formatBlock', false, '<h3>');
                } else {
                    document.execCommand(command, false, value);
                }
                syncFromVisualToTextarea();
            }
        }

        function insertTagIntoTextarea(textarea, command) {
            const start = textarea.selectionStart;
            const end = textarea.selectionEnd;
            const selectedText = textarea.value.substring(start, end);
            let openTag = '';
            let closeTag = '';

            switch (command) {
                case 'bold':
                    openTag = '<strong>';
                    closeTag = '</strong>';
                    break;
                case 'italic':
                    openTag = '<em>';
                    closeTag = '</em>';
                    break;
                case 'insertUnorderedList':
                    openTag = '<ul>\n  <li>';
                    closeTag = '</li>\n</ul>';
                    break;
                case 'insertOrderedList':
                    openTag = '<ol>\n  <li>';
                    closeTag = '</li>\n</ol>';
                    break;
                case 'h3':
                    openTag = '<h3>';
                    closeTag = '</h3>';
                    break;
                case 'removeFormat':
                    const strippedText = selectedText.replace(/<[^>]*>/g, '');
                    textarea.setRangeText(strippedText, start, end, 'select');
                    return;
            }

            const defaultText = selectedText || 'Nội dung';
            const replacement = `${openTag}${defaultText}${closeTag}`;
            textarea.setRangeText(replacement, start, end, 'select');
        }

        document.addEventListener('DOMContentLoaded', () => {
            const visual = document.getElementById('visualEditor');
            const textarea = document.getElementById('descriptionTextarea');
            const form = document.querySelector('form');

            if (visual && textarea) {
                if (!visual.innerHTML.trim() && textarea.value.trim()) {
                    visual.innerHTML = textarea.value;
                } else {
                    textarea.value = visual.innerHTML;
                }

                visual.addEventListener('input', syncFromVisualToTextarea);
                visual.addEventListener('blur', syncFromVisualToTextarea);
                textarea.addEventListener('input', syncFromTextareaToVisual);
            }

            if (form) {
                form.addEventListener('submit', () => {
                    const visualEl = document.getElementById('visualEditor');
                    const textareaEl = document.getElementById('descriptionTextarea');
                    if (visualEl && textareaEl && visualEl.style.display !== 'none') {
                        textareaEl.value = visualEl.innerHTML;
                    }
                });
            }
        });
    </script>
}
