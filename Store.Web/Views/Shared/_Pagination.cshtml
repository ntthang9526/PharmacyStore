@model PharmacyWeb.Models.ViewModels.PaginationViewModel

@if (Model != null && Model.TotalPages > 1)
{
    <nav aria-label="Page navigation" class="mt-4">
        <ul class="pagination justify-content-center gap-1 mb-0">
            <!-- Previous Button -->
            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                <a class="page-link rounded-pill px-3 shadow-none border" href="@GetPageUrl(Model.CurrentPage - 1)">
                    <i class="bi bi-chevron-left me-1"></i> @Loc["Pagination_Previous"]
                </a>
            </li>

            <!-- Page Numbers -->
            @for (int p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                    <a class="page-link rounded-circle d-flex align-items-center justify-content-center shadow-none border" 
                       style="width: 38px; height: 38px; @(p == Model.CurrentPage ? "background-color: var(--color-primary); border-color: var(--color-primary);" : "")" 
                       href="@GetPageUrl(p)">
                        @p
                    </a>
                </li>
            }

            <!-- Next Button -->
            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                <a class="page-link rounded-pill px-3 shadow-none border" href="@GetPageUrl(Model.CurrentPage + 1)">
                    @Loc["Pagination_Next"] <i class="bi bi-chevron-right ms-1"></i>
                </a>
            </li>
        </ul>
    </nav>
}

@functions {
    private string GetPageUrl(int pageNumber)
    {
        var dict = new Dictionary<string, string>(Model?.QueryParams ?? new());
        dict["Page"] = pageNumber.ToString();

        var query = string.Join("&", dict.Select(kv => $"{kv.Key}={Uri.EscapeDataString(kv.Value)}"));
        return $"{Model?.RouteUrl}?{query}";
    }
}
