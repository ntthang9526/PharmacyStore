@model PharmacyWeb.Models.ViewModels.OrderResultViewModel
@{
    ViewData["Title"] = $"Chi Tiết Đơn Hàng {Model.OrderCode}";
}

<div class="container py-4" style="max-width: 800px;">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="MyOrders" asp-action="Index" class="text-decoration-none text-muted">Đơn hàng của tôi</a></li>
            <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">@Model.OrderCode</li>
        </ol>
    </nav>

    <div class="card border-0 rounded-4 shadow-sm p-4 bg-white mb-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center pb-3 border-bottom mb-3 gap-2">
            <div>
                <h4 class="fw-bold text-dark mb-1">Đơn hàng <span class="font-monospace text-teal">@Model.OrderCode</span></h4>
                <span class="text-muted small">Thời gian đặt: @Model.OrderDate.AddHours(7).ToString("dd/MM/yyyy HH:mm")</span>
            </div>
            <div>
                @if (Model.OrderStatus == "NEW")
                {
                    <span class="badge bg-warning text-dark px-3 py-2 fs-6">Chờ xác nhận</span>
                }
                else if (Model.OrderStatus == "CONFIRMED")
                {
                    <span class="badge bg-info text-dark px-3 py-2 fs-6">Đã xác nhận</span>
                }
                else if (Model.OrderStatus == "SHIPPING")
                {
                    <span class="badge bg-primary text-white px-3 py-2 fs-6">Đang giao hàng</span>
                }
                else if (Model.OrderStatus == "COMPLETED")
                {
                    <span class="badge bg-success text-white px-3 py-2 fs-6">Hoàn tất</span>
                }
                else
                {
                    <span class="badge bg-danger text-white px-3 py-2 fs-6">Đã hủy</span>
                }
            </div>
        </div>

        <div class="row g-3 mb-4 small">
            <div class="col-md-6">
                <span class="text-muted d-block">Người nhận:</span>
                <strong>@Model.CustomerName (@Model.CustomerPhone)</strong>
            </div>
            <div class="col-md-6">
                <span class="text-muted d-block">Địa chỉ nhận hàng:</span>
                <strong>@Model.ShippingAddress</strong>
            </div>
            <div class="col-md-6">
                <span class="text-muted d-block">Phương thức thanh toán:</span>
                <strong>@(Model.PaymentMethod == "COD" ? "Thanh toán khi nhận hàng" : "Chuyển khoản")</strong>
            </div>
            <div class="col-md-6">
                <span class="text-muted d-block">Trạng thái thanh toán:</span>
                <span class="badge @(Model.PaymentStatus == "PAID" ? "bg-success" : "bg-secondary")">
                    @(Model.PaymentStatus == "PAID" ? "Đã thu tiền" : "Chưa thanh toán")
                </span>
            </div>
        </div>

        <h6 class="fw-bold text-dark mb-2">Danh sách thuốc:</h6>
        <div class="table-responsive border rounded-3 mb-4">
            <table class="table table-sm align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th class="ps-3 py-2">Tên thuốc</th>
                        <th class="text-center">Số lượng</th>
                        <th class="text-end">Đơn giá</th>
                        <th class="text-end pe-3">Thành tiền</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="ps-3 py-2 fw-semibold">@item.MedicineName (@item.Unit)</td>
                            <td class="text-center">@item.Quantity</td>
                            <td class="text-end" style="font-variant-numeric: tabular-nums;">@item.UnitPrice.ToString("N0") ₫</td>
                            <td class="text-end pe-3 fw-bold" style="font-variant-numeric: tabular-nums;">@item.TotalPrice.ToString("N0") ₫</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <td colspan="3" class="ps-3 fw-bold">Tổng thanh toán:</td>
                        <td class="text-end pe-3 fs-6 fw-bold text-teal" style="color: var(--color-primary-active); font-variant-numeric: tabular-nums;">
                            @Model.TotalAmount.ToString("N0") ₫
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center">
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách đơn
            </a>
        </div>
    </div>
</div>
