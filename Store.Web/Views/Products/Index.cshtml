@model PharmacyWeb.Models.ViewModels.ProductFilterViewModel
@{
    ViewData["Title"] = Loc["Catalog_Title"];
}

<div class="container-xxl px-3 py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">@Loc["Header_Home"]</a></li>
            <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">@Loc["Catalog_Breadcrumb"]</li>
        </ol>
    </nav>

    <!-- Mobile Filter Open Button Bar -->
    <div class="d-lg-none mb-3 d-flex justify-content-between align-items-center bg-white p-3 rounded-3 shadow-xs border">
        <span class="small fw-semibold text-secondary">@string.Format(Loc["Catalog_Found"].Value, Model.Results.TotalItems)</span>
        <button class="btn btn-ph btn-ph-secondary btn-ph-sm" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileFilterDrawer">
            <i class="bi bi-funnel-fill me-1"></i> @Loc["Catalog_FilterBtn"]
        </button>
    </div>

    <div class="row g-4">
        <!-- Desktop Filter Sidebar -->
        <aside class="col-lg-3 d-none d-lg-block">
            <div class="card border-0 rounded-4 shadow-sm p-4 bg-white">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0 text-teal" style="color: var(--color-primary);">
                        <i class="bi bi-funnel-fill me-1"></i> @Loc["Catalog_FilterHeader"]
                    </h6>
                    <a asp-action="Index" class="text-decoration-none small text-muted">@Loc["Catalog_ClearFilter"]</a>
                </div>

                <form id="catalogFilterForm" asp-action="Index" method="get">
                    <!-- Keyword -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">@Loc["Catalog_KeywordLabel"]</label>
                        <input type="text" name="Keyword" class="form-control form-control-sm rounded-pill" placeholder="@Loc["Catalog_KeywordPlaceholder"]" value="@Model.Keyword" />
                    </div>

                    <!-- Categories -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">@Loc["Catalog_CategoryLabel"]</label>
                        <div class="d-flex flex-column gap-1">
                            <div class="form-check small">
                                <input class="form-check-input" type="radio" name="CategoryId" id="cat_all" value="" @(!Model.CategoryId.HasValue ? "checked" : "") />
                                <label class="form-check-label" for="cat_all">@Loc["Catalog_AllCategories"]</label>
                            </div>
                            @foreach (var cat in Model.Categories)
                            {
                                <div class="form-check small">
                                    <input class="form-check-input" type="radio" name="CategoryId" id="cat_@cat.Id" value="@cat.Id" @(Model.CategoryId == cat.Id ? "checked" : "") />
                                    <label class="form-check-label d-flex justify-content-between" for="cat_@cat.Id">
                                        <span class="text-truncate">@cat.Name</span>
                                        <span class="text-muted">(@cat.ProductCount)</span>
                                    </label>
                                </div>
                            }
                        </div>
                    </div>

                    <hr class="text-muted my-3 opacity-25" />

                    <!-- Price Range -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">@Loc["Catalog_PriceRange"]</label>
                        <div class="row g-1">
                            <div class="col-6">
                                <input type="number" name="MinPrice" class="form-control form-control-sm rounded-pill" placeholder="@Loc["Catalog_From"]" value="@Model.MinPrice" />
                            </div>
                            <div class="col-6">
                                <input type="number" name="MaxPrice" class="form-control form-control-sm rounded-pill" placeholder="@Loc["Catalog_To"]" value="@Model.MaxPrice" />
                            </div>
                        </div>
                    </div>

                    <hr class="text-muted my-3 opacity-25" />

                    <!-- Toggles -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">@Loc["Catalog_ClassificationStock"]</label>
                        <div class="form-check form-switch small mb-2">
                            <input class="form-check-input" type="checkbox" name="DirectPurchaseOnly" id="opt_otc" value="true" @(Model.DirectPurchaseOnly == true ? "checked" : "") />
                            <label class="form-check-label" for="opt_otc">@Loc["Catalog_DirectPurchaseOnly"]</label>
                        </div>
                        <div class="form-check form-switch small">
                            <input class="form-check-input" type="checkbox" name="OnlyInStock" id="opt_instock" value="true" @(Model.OnlyInStock == true ? "checked" : "") />
                            <label class="form-check-label" for="opt_instock">@Loc["Catalog_OnlyInStock"]</label>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-ph btn-ph-primary w-100 btn-sm">
                        <i class="bi bi-filter me-1"></i> @Loc["Catalog_ApplyFilter"]
                    </button>
                </form>
            </div>
        </aside>

        <!-- Main Product Grid -->
        <main class="col-12 col-lg-9">
            <!-- Header bar with Count and Sorting -->
            <div class="card border-0 rounded-4 shadow-sm p-3 bg-white mb-3">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div>
                        <span class="fw-semibold text-dark">@string.Format(Loc["Catalog_Showing"].Value, Model.Results.TotalItems)</span>
                        @if (!string.IsNullOrWhiteSpace(Model.Keyword))
                        {
                            <span class="text-muted small">@Loc["Catalog_ForKeyword"]: <strong>"@Model.Keyword"</strong></span>
                        }
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <label class="small text-muted text-nowrap mb-0">@Loc["Catalog_SortLabel"]</label>
                        <select id="sortSelect" name="SortBy" class="form-select form-select-sm rounded-pill border-secondary-subtle" style="width: auto;" onchange="updateSort(this.value)">
                            <option value="default" selected="@(Model.SortBy == "default")">@Loc["Catalog_SortDefault"]</option>
                            <option value="price_asc" selected="@(Model.SortBy == "price_asc")">@Loc["Catalog_SortPriceAsc"]</option>
                            <option value="price_desc" selected="@(Model.SortBy == "price_desc")">@Loc["Catalog_SortPriceDesc"]</option>
                            <option value="name_asc" selected="@(Model.SortBy == "name_asc")">@Loc["Catalog_SortNameAsc"]</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Grid Container -->
            <div id="productGridContainer">
                <partial name="_ProductGridPartial" model="Model" />
            </div>
        </main>
    </div>
</div>

<!-- Mobile Offcanvas Filter Drawer -->
<div class="offcanvas offcanvas-start" tabindex="-1" id="mobileFilterDrawer" aria-labelledby="mobileFilterDrawerLabel">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title fw-bold text-teal" id="mobileFilterDrawerLabel">
            <i class="bi bi-funnel-fill me-1"></i> @Loc["Catalog_FilterHeader"]
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <form asp-action="Index" method="get">
            <div class="mb-3">
                <label class="form-label small fw-semibold text-secondary">@Loc["Catalog_KeywordLabel"]</label>
                <input type="text" name="Keyword" class="form-control form-control-sm rounded-pill" value="@Model.Keyword" />
            </div>

            <div class="mb-3">
                <label class="form-label small fw-semibold text-secondary">@Loc["Catalog_CategoryLabel"]</label>
                <div class="d-flex flex-column gap-1">
                    <div class="form-check small">
                        <input class="form-check-input" type="radio" name="CategoryId" id="m_cat_all" value="" @(!Model.CategoryId.HasValue ? "checked" : "") />
                        <label class="form-check-label" for="m_cat_all">@Loc["Catalog_AllCategories"]</label>
                    </div>
                    @foreach (var cat in Model.Categories)
                    {
                        <div class="form-check small">
                            <input class="form-check-input" type="radio" name="CategoryId" id="m_cat_@cat.Id" value="@cat.Id" @(Model.CategoryId == cat.Id ? "checked" : "") />
                            <label class="form-check-label d-flex justify-content-between" for="m_cat_@cat.Id">
                                <span>@cat.Name</span>
                                <span class="text-muted">(@cat.ProductCount)</span>
                            </label>
                        </div>
                    }
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label small fw-semibold text-secondary">@Loc["Catalog_PriceRange"]</label>
                <div class="row g-1">
                    <div class="col-6"><input type="number" name="MinPrice" class="form-control form-control-sm rounded-pill" placeholder="@Loc["Catalog_From"]" value="@Model.MinPrice" /></div>
                    <div class="col-6"><input type="number" name="MaxPrice" class="form-control form-control-sm rounded-pill" placeholder="@Loc["Catalog_To"]" value="@Model.MaxPrice" /></div>
                </div>
            </div>

            <div class="mb-4">
                <div class="form-check form-switch small mb-2">
                    <input class="form-check-input" type="checkbox" name="DirectPurchaseOnly" id="m_opt_otc" value="true" @(Model.DirectPurchaseOnly == true ? "checked" : "") />
                    <label class="form-check-label" for="m_opt_otc">@Loc["Catalog_DirectPurchaseOnly"]</label>
                </div>
                <div class="form-check form-switch small">
                    <input class="form-check-input" type="checkbox" name="OnlyInStock" id="m_opt_instock" value="true" @(Model.OnlyInStock == true ? "checked" : "") />
                    <label class="form-check-label" for="m_opt_instock">@Loc["Catalog_OnlyInStock"]</label>
                </div>
            </div>

            <button type="submit" class="btn btn-ph btn-ph-primary w-100">@Loc["Catalog_ApplyFilter"]</button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function updateSort(val) {
            const form = document.getElementById('catalogFilterForm');
            let sortInput = form.querySelector('input[name="SortBy"]');
            if (!sortInput) {
                sortInput = document.createElement('input');
                sortInput.type = 'hidden';
                sortInput.name = 'SortBy';
                form.appendChild(sortInput);
            }
            sortInput.value = val;
            form.submit();
        }

        document.getElementById('catalogFilterForm').addEventListener('submit', function (e) {
            e.preventDefault();
            const formData = new FormData(this);
            const params = new URLSearchParams(formData).toString();

            const container = document.getElementById('productGridContainer');
            container.style.opacity = '0.5';

            fetch('@Url.Action("Index", "Products")?' + params, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(res => res.text())
            .then(html => {
                container.innerHTML = html;
                container.style.opacity = '1';
                window.history.pushState(null, '', '@Url.Action("Index", "Products")?' + params);
            })
            .catch(() => {
                this.submit();
            });
        });
    </script>
}
