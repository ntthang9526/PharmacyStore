@inject PharmacyWeb.Services.IProductService ProductService
@{
    var currentCulture = System.Threading.Thread.CurrentThread.CurrentUICulture.Name;
    var isEn = currentCulture.StartsWith("en");
    ViewData["Title"] = isEn ? "Home - Pharmacy Store" : "Trang Chủ - Nhà Thuốc Pharmacy";
    var featured = ViewBag.FeaturedProducts as List<ProductCardViewModel> ?? new();
    var rxProducts = ViewBag.RxProducts as List<ProductCardViewModel> ?? new();
    var healthcareProducts = ViewBag.HealthcareProducts as List<ProductCardViewModel> ?? new();

    var homeCategories = await ProductService.GetCategoriesWithCountAsync();
    var vitaminCat = homeCategories.FirstOrDefault(c => c.Slug.Contains("vitamin") || c.Name.ToLower().Contains("vitamin")) ?? homeCategories.ElementAtOrDefault(1);
    var medSupplyCat = homeCategories.FirstOrDefault(c => c.Slug.Contains("vat-tu") || c.Name.ToLower().Contains("vật tư")) ?? homeCategories.ElementAtOrDefault(2);
}

<div class="container-xxl px-3 py-4">
    <!-- Khu vực Hero Đôi (Banner Chính thức + Khối Gửi đơn thuốc tư vấn) -->
    <section class="mb-4" aria-label="@(isEn ? "Search medicines and submit prescription" : "Tìm nhanh thuốc và gửi đơn tư vấn")">
        <div class="row g-3 align-items-stretch">
            <div class="col-12 col-lg-8">
                <div class="store-hero-banner h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex flex-wrap gap-2 mb-2">
                            <span class="status-badge status-badge-info"><i class="bi bi-shield-check me-1"></i> @(isEn ? "Authentic Pharmacy • Dedicated Pharmacists" : "Hệ thống Nhà thuốc Chính hãng • Dược sĩ tận tâm")</span>
                        </div>
                        <h1 class="h3 fw-bold mb-2" style="color:var(--color-primary-active);">
                            @(isEn ? "Comprehensive Healthcare for Your Family" : "Chăm sóc Sức khỏe Toàn diện cho Cả Gia đình")
                        </h1>
                        <p class="text-secondary mb-3" style="max-width:60ch;">
                            @(isEn ? "Order common medicines, vitamins, and medical supplies delivered home, or submit prescription photos for pharmacist consultation." : "Đặt mua nhanh thuốc thông thường, vitamin và thiết bị y tế giao tận nơi hoặc gửi ảnh đơn thuốc để dược sĩ tư vấn chuyên môn.")
                        </p>
                    </div>
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 pt-2 border-top" style="border-color:#99F6E4!important;">
                        <div class="d-flex flex-wrap gap-2">
                            <a asp-controller="Products" asp-action="Index" asp-route-DirectPurchaseOnly="true" class="btn-ph btn-ph-primary text-decoration-none">
                                <i class="bi bi-cart3 me-1"></i> <span>@(isEn ? "Buy Online" : "Mua thuốc trực tuyến")</span>
                            </a>
                            <a asp-controller="PrescriptionRequest" asp-action="Index" class="btn-ph btn-ph-secondary text-decoration-none">
                                <i class="bi bi-camera me-1"></i> <span>@(isEn ? "Send Prescription" : "Gửi ảnh đơn thuốc")</span>
                            </a>
                        </div>
                        <div class="d-flex align-items-center gap-2 small text-secondary">
                            <i class="bi bi-truck text-teal"></i>
                            <span>@(isEn ? "Fast 2h Delivery in Urban" : "Giao nhanh 2h nội thành")</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-4">
                <div class="store-hero-side h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="status-badge status-badge-warning"><i class="bi bi-bell-fill me-1"></i> @(isEn ? "Online Pharmacist" : "Dược sĩ trực tuyến")</span>
                        </div>
                        <h2 class="h5 fw-bold text-dark mb-2">
                            @(isEn ? "Have a Prescription? Let Us Help!" : "Có đơn thuốc bác sĩ? Để chúng tôi tư vấn")
                        </h2>
                        <p class="small text-secondary mb-3">
                            @(isEn ? "Upload your prescription image. Our certified pharmacists will check stock, confirm dosage, and call you directly." : "Chụp ảnh đơn thuốc gửi qua hệ thống. Dược sĩ chuyên môn kiểm tra tồn kho, liều dùng và gọi lại hỗ trợ ngay.")
                        </p>
                    </div>
                    <div>
                        <a asp-controller="PrescriptionRequest" asp-action="Index" class="btn-ph btn-ph-rx w-100 text-center text-decoration-none justify-content-center py-2 mb-2">
                            <i class="bi bi-cloud-arrow-up-fill me-1"></i> @(isEn ? "Upload Prescription Now" : "Tải ảnh đơn thuốc ngay")
                        </a>
                        <div class="text-center small text-muted">
                            <i class="bi bi-lock-fill me-1"></i> @(isEn ? "100% Confidential medical data" : "Bảo mật tuyệt đối thông tin bệnh án")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Hàng Quick Access (6 ô biểu tượng nhanh, responsive chuẩn Long Châu) -->
    <section class="mb-4" aria-label="Lối tắt truy cập nhanh">
        <div class="row g-2 g-md-3">
            <div class="col-6 col-md-4 col-xl-2">
                <a asp-controller="Products" asp-action="Index" class="lc-quick-tile text-decoration-none">
                    <span class="lc-quick-tile-icon"><i class="bi bi-grid-fill"></i></span>
                    <div>
                        <div class="fw-bold small text-dark">@(isEn ? "All Products" : "Tất cả sản phẩm")</div>
                        <div class="text-muted" style="font-size:11px;">@(isEn ? "Full catalog" : "Danh mục đầy đủ")</div>
                    </div>
                </a>
            </div>
            <div class="col-6 col-md-4 col-xl-2">
                <a asp-controller="Products" asp-action="Index" asp-route-DirectPurchaseOnly="true" class="lc-quick-tile text-decoration-none">
                    <span class="lc-quick-tile-icon green"><i class="bi bi-bag-check-fill"></i></span>
                    <div>
                        <div class="fw-bold small text-dark">@(isEn ? "Direct Purchase" : "Mua trực tiếp")</div>
                        <div class="text-muted" style="font-size:11px;">@(isEn ? "No Rx required" : "Không cần kê đơn")</div>
                    </div>
                </a>
            </div>
            <div class="col-6 col-md-4 col-xl-2">
                <a asp-controller="PrescriptionRequest" asp-action="Index" class="lc-quick-tile text-decoration-none">
                    <span class="lc-quick-tile-icon"><i class="bi bi-file-earmark-medical-fill"></i></span>
                    <div>
                        <div class="fw-bold small text-dark">@(isEn ? "Prescription" : "Thuốc theo đơn")</div>
                        <div class="text-muted" style="font-size:11px;">@(isEn ? "Requires prescription" : "Cần đơn bác sĩ")</div>
                    </div>
                </a>
            </div>
            <div class="col-6 col-md-4 col-xl-2">
                <a asp-controller="MyOrders" asp-action="Index" class="lc-quick-tile text-decoration-none">
                    <span class="lc-quick-tile-icon green"><i class="bi bi-box-seam"></i></span>
                    <div>
                        <div class="fw-bold small text-dark">@(isEn ? "My Orders" : "Đơn hàng của tôi")</div>
                        <div class="text-muted" style="font-size:11px;">@(isEn ? "Track status" : "Tra cứu trạng thái")</div>
                    </div>
                </a>
            </div>
            <div class="col-6 col-md-4 col-xl-2">
                <a href="@(vitaminCat != null ? Url.Action("Index", "Products", new { CategoryId = vitaminCat.Id }) : Url.Action("Index", "Products"))" class="lc-quick-tile text-decoration-none">
                    <span class="lc-quick-tile-icon"><i class="bi bi-capsule"></i></span>
                    <div>
                        <div class="fw-bold small text-dark">@(isEn ? "Vitamins" : (vitaminCat?.Name ?? "Vitamin & Đề kháng"))</div>
                        <div class="text-muted" style="font-size:11px;">@(isEn ? "Essential nutrients" : "Bổ sung khoáng chất")</div>
                    </div>
                </a>
            </div>
            <div class="col-6 col-md-4 col-xl-2">
                <a href="@(medSupplyCat != null ? Url.Action("Index", "Products", new { CategoryId = medSupplyCat.Id }) : Url.Action("Index", "Products"))" class="lc-quick-tile text-decoration-none">
                    <span class="lc-quick-tile-icon green"><i class="bi bi-bandaid"></i></span>
                    <div>
                        <div class="fw-bold small text-dark">@(isEn ? "Medical Supplies" : (medSupplyCat?.Name ?? "Vật tư y tế"))</div>
                        <div class="text-muted" style="font-size:11px;">@(isEn ? "Family first-aid" : "Tủ thuốc gia đình")</div>
                    </div>
                </a>
            </div>
        </div>
    </section>

    <!-- Khối 1: Sản phẩm Mua trực tiếp Nổi bật với Dải Ribbon Teal POS -->
    <section class="lc-section-card mb-4" aria-labelledby="homeFeaturedOtcHeading">
        <div class="lc-section-ribbon">
            <div>
                <h2 class="h5 fw-bold mb-0 text-white" id="homeFeaturedOtcHeading">
                    <i class="bi bi-stars me-1 text-warning"></i> @(isEn ? "Best Selling Products" : "Sản phẩm bán chạy nổi bật")
                </h2>
            </div>
            <a asp-controller="Products" asp-action="Index" asp-route-DirectPurchaseOnly="true" class="btn-ph btn-ph-secondary btn-ph-sm text-decoration-none">
                @(isEn ? "View all" : "Xem tất cả") <i class="bi bi-chevron-right ms-1"></i>
            </a>
        </div>
        <div class="row g-3">
            @foreach (var med in featured)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <partial name="_ProductCard" model="med" />
                </div>
            }
        </div>
    </section>

    <!-- Khối 2: Nhóm Thuốc cần đơn bác sĩ -->
    <section class="lc-section-card mb-4" aria-labelledby="homeRxSectionHeading">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3 pb-2 border-bottom">
            <div>
                <h2 class="h5 fw-bold mb-0" id="homeRxSectionHeading" style="color:var(--color-primary-active);">
                    <i class="bi bi-file-earmark-medical me-1 text-teal"></i> @(isEn ? "Doctor Prescription Medicines" : "Thuốc cần đơn bác sĩ")
                </h2>
                <p class="small text-secondary mb-0">@(isEn ? "Professional pharmacists review prescription and consult directly" : "Dược sĩ chuyên môn kiểm tra đơn thuốc và tư vấn trực tiếp")</p>
            </div>
            <a asp-controller="Products" asp-action="Index" class="btn-ph btn-ph-rx btn-ph-sm text-decoration-none">
                @(isEn ? "View all" : "Xem tất cả") <i class="bi bi-chevron-right ms-1"></i>
            </a>
        </div>
        <div class="row g-3">
            @foreach (var med in rxProducts)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <partial name="_ProductCard" model="med" />
                </div>
            }
        </div>
    </section>

    <!-- Khối 3: Sản phẩm Chăm sóc Sức khỏe & Tủ thuốc Gia đình -->
    <section class="lc-section-card mb-4" aria-labelledby="homeFamilySectionHeading">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3 pb-2 border-bottom">
            <div>
                <h2 class="h5 fw-bold mb-0" id="homeFamilySectionHeading" style="color:var(--color-primary-active);">
                    <i class="bi bi-heart-pulse me-1 text-danger"></i> @(isEn ? "Family First-Aid & Immune Health" : "Tủ thuốc gia đình & Đề kháng")
                </h2>
                <p class="small text-secondary mb-0">@(isEn ? "Electrolyte rehydration, stomach care, and essential vitamins" : "Bù nước điện giải, chăm sóc dạ dày và vitamin thiết yếu")</p>
            </div>
            <a href="@(vitaminCat != null ? Url.Action("Index", "Products", new { CategoryId = vitaminCat.Id }) : Url.Action("Index", "Products"))" class="btn-ph btn-ph-secondary btn-ph-sm text-decoration-none">
                @(isEn ? "View more" : "Xem thêm") <i class="bi bi-chevron-right ms-1"></i>
            </a>
        </div>
        <div class="row g-3">
            @foreach (var med in healthcareProducts)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <partial name="_ProductCard" model="med" />
                </div>
            }
        </div>
    </section>
</div>
