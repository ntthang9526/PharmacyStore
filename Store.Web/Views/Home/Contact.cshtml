@{
    ViewData["Title"] = "Liên Hệ & Hỗ Trợ";
}

<div class="container py-4" style="max-width: 800px;">
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
        <h3 class="fw-bold text-teal mb-3" style="color: var(--color-primary);">Liên Hệ Với Nhà Thuốc Pharmacy</h3>
        
        <div class="row g-4 mt-2">
            <div class="col-md-6">
                <div class="card bg-light border-0 p-3 h-100 rounded-3">
                    <h6 class="fw-bold text-dark"><i class="bi bi-telephone-fill me-2 text-teal"></i>Tổng đài chăm sóc</h6>
                    <p class="mb-1">Tư vấn sức khỏe: <strong>1800 6928</strong></p>
                    <p class="mb-0 text-muted small">Thời gian: 07:00 - 22:00 hàng ngày</p>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card bg-light border-0 p-3 h-100 rounded-3">
                    <h6 class="fw-bold text-dark"><i class="bi bi-geo-alt-fill me-2 text-danger"></i>Địa chỉ chi nhánh mẫu</h6>
                    <p class="mb-1">Số 42 Đường 3/2, P. Xuân Khánh, Q. Ninh Kiều, Cần Thơ</p>
                    <p class="mb-0 text-muted small">Nhà thuốc mở cửa 24/7</p>
                </div>
            </div>
        </div>
    </div>
</div>
