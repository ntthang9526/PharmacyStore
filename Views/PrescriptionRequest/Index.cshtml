@model PharmacyWeb.Models.ViewModels.PrescriptionUploadViewModel
@{
    ViewData["Title"] = "Tư Vấn Đơn Thuốc Bác Sĩ";
    var requests = ViewBag.Requests as List<PharmacyWeb.Models.ViewModels.PrescriptionRequestItemViewModel> ?? new();
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Trang chủ</a></li>
            <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">Tư vấn đơn thuốc</li>
        </ol>
    </nav>

    <div class="row g-4">
        <!-- Left: Upload Form -->
        <div class="col-lg-5">
            <div class="card border-0 rounded-4 shadow-sm p-4 bg-white">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center text-teal" style="width: 40px; height: 40px; background-color: var(--color-primary-soft);">
                        <i class="bi bi-camera-fill fs-5"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0 text-teal" style="color: var(--color-primary);">Gửi Ảnh Đơn Thuốc</h5>
                        <span class="text-muted small">Dược sĩ phản hồi trong vòng 15 phút</span>
                    </div>
                </div>

                <div class="alert alert-info py-2 px-3 small border-0 rounded-3 mb-3" style="background-color: var(--color-info-bg); color: var(--color-info);">
                    <i class="bi bi-shield-lock-fill me-1"></i>
                    <strong>Bảo mật y tế:</strong> Ảnh đơn thuốc được lưu trữ riêng tư, chỉ dược sĩ phụ trách và bạn mới có quyền xem.
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3">
                        <div asp-validation-summary="All" class="mb-0"></div>
                    </div>
                }

                <form asp-action="Upload" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="PatientName" class="form-label small fw-semibold text-secondary"></label>
                        <input asp-for="PatientName" class="form-control rounded-3" placeholder="Họ và tên người bệnh..." />
                        <span asp-validation-for="PatientName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Phone" class="form-label small fw-semibold text-secondary"></label>
                        <input asp-for="Phone" class="form-control rounded-3" placeholder="Số điện thoại dược sĩ liên hệ..." />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CustomerNote" class="form-label small fw-semibold text-secondary"></label>
                        <textarea asp-for="CustomerNote" rows="2" class="form-control rounded-3" placeholder="Ghi chú về tiền sử dị ứng, triệu chứng hoặc câu hỏi cho dược sĩ..."></textarea>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Images" class="form-label small fw-semibold text-secondary"></label>
                        <input asp-for="Images" type="file" multiple class="form-control rounded-3" accept=".jpg,.jpeg,.png,.webp" required />
                        <span class="text-muted" style="font-size: 0.75rem;">Hỗ trợ định dạng JPEG, PNG, WebP (Tối đa 5MB/ảnh).</span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 rounded-pill py-2 fw-bold shadow-sm" style="background-color: var(--color-primary); border-color: var(--color-primary);">
                        <i class="bi bi-cloud-arrow-up-fill me-1"></i> Gửi đơn cho dược sĩ
                    </button>
                </form>
            </div>
        </div>

        <!-- Right: My Requests History -->
        <div class="col-lg-7">
            <div class="card border-0 rounded-4 shadow-sm p-4 bg-white">
                <h5 class="fw-bold text-dark mb-3">
                    <i class="bi bi-clock-history me-2 text-teal"></i>Đơn thuốc đã gửi (@requests.Count yêu cầu)
                </h5>

                @if (!requests.Any())
                {
                    <div class="p-5 text-center text-muted">
                        <i class="bi bi-file-earmark-medical display-4 opacity-50 mb-2"></i>
                        <p class="small mb-0">Bạn chưa gửi ảnh đơn thuốc nào. Vui lòng gửi ảnh ở khung bên trái khi cần mua thuốc kê đơn.</p>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var req in requests)
                        {
                            <div class="p-3 rounded-3 border bg-light">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="fw-bold font-monospace text-teal fs-6" style="color: var(--color-primary);">@req.Code</span>
                                    @if (req.Status == "PENDING_REVIEW")
                                    {
                                        <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Chờ dược sĩ kiểm tra</span>
                                    }
                                    else if (req.Status == "NEED_MORE_INFO")
                                    {
                                        <span class="badge bg-danger text-white"><i class="bi bi-exclamation-triangle me-1"></i>Cần bổ sung ảnh/thông tin</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success text-white"><i class="bi bi-check-circle me-1"></i>Dược sĩ đã phản hồi</span>
                                    }
                                </div>

                                <div class="small text-muted mb-2">
                                    <span>Bệnh nhân: <strong>@req.PatientName</strong> (@req.Phone)</span> • 
                                    <span>Gửi lúc: @req.CreatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")</span>
                                </div>

                                @if (!string.IsNullOrEmpty(req.CustomerNote))
                                {
                                    <div class="p-2 rounded bg-white small mb-2 border">
                                        <strong class="text-secondary">Ghi chú của bạn:</strong> @req.CustomerNote
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(req.PharmacistNote))
                                {
                                    <div class="p-2 rounded bg-success-subtle border border-success-subtle small mb-2 text-dark">
                                        <div class="fw-bold text-success mb-1"><i class="bi bi-chat-quote-fill me-1"></i>Phản hồi từ Dược sĩ:</div>
                                        <div>@req.PharmacistNote</div>
                                    </div>
                                }

                                <!-- Prescription Images Preview Link -->
                                <div class="d-flex flex-wrap gap-2 pt-2 border-top">
                                    @foreach (var img in req.Images)
                                    {
                                        <a href="@img.ViewUrl" target="_blank" class="btn btn-outline-secondary btn-sm rounded-pill py-1 px-3" style="font-size: 0.75rem;">
                                            <i class="bi bi-eye me-1"></i> Xem ảnh đơn (@img.FileName)
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
