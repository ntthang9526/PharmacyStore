# Copy thanh .env. Doi DB_SERVER theo ten SQL Server tren may.
DB_SERVER=.\SQLEXPRESS
DB_NAME=PharmacyStoreDB
DB_INTEGRATED_SECURITY=true

# Chi dien hai muc nay khi dung SQL Authentication va dat Integrated Security=false.
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
DB_CONNECT_TIMEOUT=30
